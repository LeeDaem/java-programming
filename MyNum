import java.util.*;

public class MyNum {
    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);
        
        int i, j, n;
        
        System.out.print("길이 입력 : ");
        n = sc.nextInt();
        
        for(i = 0; i < n; i++) {
            System.out.printf("%2d", i);
            
            // 2
            for(j = 0; j < n; j++) {
                if(i == 0 || i == n - 1 || i == n / 2){
                    System.out.print("*");
                }else{
                    System.out.print("#");
                }
            }
            if(i != 0 || i != n - 1 || i != n / 2) {
                System.out.print("*");
            }
        }
    }
}
            
                    